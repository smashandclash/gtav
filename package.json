{
  "name": "smashandclash-fivem",
  "version": "1.0.0",
  "private": true,
  "description": "Smash&Clash inside GTA V: a FiveM resource whose in-game client is built on the Smash&Clash SDK.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.smashandclash.in",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node tools/vendor-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && node tools/check-lua.mjs",
    "release": "npm run build && node tools/release.mjs"
  },
  "dependencies": {
    "@smashandclash/sdk": "^0.5.0"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wasmoon": "^1.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smashandclash/gtav"
  }
}
